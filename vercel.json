{
  "version": 2,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/vouchers/scans",
      "destination": "/api/scanner/locations?action=scans"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
