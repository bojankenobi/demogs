# ==============================================================================
# Grand Slot Club - Environment Variables Configuration
# ==============================================================================

# Neon Serverless PostgreSQL Connection String
# Get this from your Neon Console (https://console.neon.tech):
# e.g. postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-grandslot-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Web Push VAPID Keys (for sending push notifications to browsers)
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=BExamplePublicKeyFromGenerateScript...
VAPID_PRIVATE_KEY=ExamplePrivateKeyFromGenerateScript...
VAPID_EMAIL=mailto:support@grandslotclub.rs

# Admin Security Secret (for API authentication)
ADMIN_SECRET_KEY=grandslot_secure_operator_key_2026
